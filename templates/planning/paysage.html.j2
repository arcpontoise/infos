{% extends "base.html.j2" %}
{% block titre %}Planning de la semaine — saison {{ saison }}{% endblock %}
{% block description %}Grille hebdomadaire des créneaux, saison {{ saison }}.{% endblock %}
{% block styles %}
main { overflow-x: auto; }
.autre-vue { margin: 0 0 1rem; }
.autre-vue a { color: var(--accent); font-weight: 600; }
{% include "planning/_grille.css" %}
@media print {
  @page { size: A4 landscape; margin: 7mm 8mm; }

  /* Fill the page: the grid takes whatever the compact header leaves */
  :root { --hauteur-grille: 126mm; }
  body { background: #fff; font-size: 11px; }
  footer.site, nav.site, .autre-vue { display: none; }
  main { overflow: visible; padding: 0; }
  header.site {
    background: none;
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
    padding: 0 0 1.5mm;
    margin-bottom: 2mm;
  }
  header.site .entete-flex { gap: 3mm; }
  header.site .logo { height: 11mm; }
  header.site .manuscrit { font-size: 13px; color: var(--gray); }
  header.site .titre { font-size: 17px; margin: 0; }

  /* Legend: readable, and matching the print colours below */
  .legende { margin: 0 0 2mm; font-size: 10px; color: var(--ink); gap: 1mm 6mm; }
  .legende .pastille { width: 11px; height: 11px; }
  .legende span { white-space: nowrap; }

  .grille { min-width: 0; }
  .entetes h2 { font-size: 11px; padding: 1.5mm 1mm; color: var(--ink); }
  .heure-axe { font-size: 10px; font-weight: 600; color: var(--ink); }

  /* Hour lines plus lighter half-hour lines, to place 18 h 30 at a glance */
  .colonne {
    background:
      repeating-linear-gradient(
        to bottom,
        var(--border) 0 1px,
        transparent 1px calc(100% / {{ nb_heures }})
      ),
      repeating-linear-gradient(
        to bottom,
        transparent 0 calc(50% / {{ nb_heures }}),
        #e3e5ec calc(50% / {{ nb_heures }}) calc(50% / {{ nb_heures }} + 1px),
        transparent calc(50% / {{ nb_heures }} + 1px) calc(100% / {{ nb_heures }})
      )
      #fff;
  }

  /* Slots: larger text, full opacity details */
  .bloc { font-size: 10.5px; line-height: 1.25; padding: 1.2mm 1.6mm; border-left-width: 4px; }
  .bloc time { font-weight: 700; }
  .bloc h3 { font-size: 1.12em; font-weight: 700; margin: 0.6mm 0 0.8mm; }
  .bloc p { opacity: 1; font-size: 0.95em; }
  .bloc.compact { font-size: 9px; padding: 1mm; }
  .bloc.compact h3 { font-size: 1em; }

  /* Free practice */
  .rangee-libre { margin-top: 2mm; }
  .rangee-libre .libre, .libre-pleine {
    font-size: 9.5px;
    line-height: 1.3;
    padding: 1.2mm 1.6mm;
  }
  .libre-pleine { margin: 2mm 0 0 64px; }
  .note { font-size: 11px; margin: 2.5mm 0 0; }

  .bloc, .colonne, .pastille { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
}
{% endblock %}
{% block contenu %}
<p class="autre-vue"><a href="./">Vue liste, adaptée au téléphone</a> — {% if pdf_disponible %}<a href="{{ pdf_planning }}" download>Télécharger le planning en PDF</a>{% endif %}</p>
{% include "planning/_grille.html.j2" %}{% endblock %}
