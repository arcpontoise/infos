<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block titre %}{% endblock %} — {{ club }}</title>
<meta name="description" content="{% block description %}{% endblock %}">
<link rel="icon" href="{{ charte }}/img/logo.png">
<link rel="stylesheet" href="{{ charte }}/css/tokens.css">
<link rel="stylesheet" href="{{ charte }}/css/charte.css">
<style>
/* Site-specific rules; shared styles come from the charte */
/* Generated PDFs use the embedded font, so every build machine renders them the same */
@media print { body { font-family: var(--font-print); } }
{% block styles %}{% endblock %}
</style>
</head>
<body>
<header class="site">
  <div class="gabarit entete-flex">
    <img class="logo" src="{{ charte }}/img/logo.png" alt="">
    <div>
    <p class="manuscrit">{{ club }}</p>
    <h1 class="titre">{% block entete %}{{ self.titre() }}{% endblock %}</h1>
    {% block sous_entete %}{% endblock %}
    </div>
  </div>
</header>
<nav class="site gabarit">
  <a href="{{ prefixe }}."{% if page == 'accueil' %} aria-current="page"{% endif %}>Accueil</a>
  <a href="{{ prefixe }}planning/"{% if page == 'planning' %} aria-current="page"{% endif %}>Planning</a>
  <a href="{{ prefixe }}tarifs/"{% if page == 'tarifs' %} aria-current="page"{% endif %}>Tarifs</a>
  <a href="{{ prefixe }}calculateur/"{% if page == 'calculateur' %} aria-current="page"{% endif %}>Calculateur</a>
  <a href="{{ prefixe }}plaquette/"{% if page == 'plaquette' %} aria-current="page"{% endif %}>Plaquette</a>
</nav>
<main class="gabarit">
{% block contenu %}{% endblock %}
</main>
<footer class="site gabarit">
  <p>Mis à jour le {{ date_generation }} — <a href="https://arcpontoise.fr/">arcpontoise.fr</a></p>
</footer>
</body>
</html>
