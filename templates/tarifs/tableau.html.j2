{% extends "base.html.j2" %}
{% block titre %}Tarifs des licences {{ saison_tarifs }}{% endblock %}
{% block description %}Prix des licences {{ saison_tarifs }} par catégorie, avec les remises famille.{% endblock %}
{% block styles %}
.defilement { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; min-width: 900px; background: var(--card); font-size: 0.92rem; }
caption { text-align: left; padding: 0 0 0.6rem; color: var(--gray); }
th, td { border: 1px solid var(--border); padding: 0.5rem 0.65rem; text-align: right; }
th[scope="col"] { background: var(--blue); color: #fff; font-weight: 600; text-align: center; }
th[scope="row"] { white-space: normal; text-align: left; font-weight: 600; color: var(--ink); background: #eef1f8; }
th[scope="row"] small { display: block; font-weight: 400; color: var(--gray); }
td.total { font-weight: 700; background: #e8edf7; }
.notes { margin-top: 1rem; }
.notes p { margin: 0.4rem 0; font-size: 1.2rem; font-weight: bold; }
.notes p span { color: var(--danger); }
.telecharger { margin: 0 0 1rem; }
.telecharger a { color: var(--accent); font-weight: 600; }
@media print {
  @page { size: A4 landscape; margin: 10mm; }
  body { background: #fff; font-size: 15px; }
  nav.site, .telecharger, footer.site { display: none; }
  header.site { background: none; color: var(--ink); border-bottom-color: var(--ink); padding: 0 0 0.5rem; }
  header.site .manuscrit { display: none; }
  header.site .titre { font-size: 1.5rem; margin: 0; }
  header.site .logo { height: 38px; }
  main { padding: 0.5rem 0 0; }
  .defilement { overflow: visible; }
  table { min-width: 0; width: 100%; table-layout: fixed; font-size: 15px; }
  th[scope="col"] { white-space: normal; line-height: 1.2; font-size: 13px; overflow-wrap: anywhere; }
  {# Widths leave room for wider fonts (DejaVu Sans on the CI runner): numbers
     never wrap, headers wrap on two or three lines at most. #}
  th[scope="col"]:nth-child(1) { width: 16%; }
  th[scope="col"]:nth-child(2) { width: 8%; }
  th[scope="col"]:nth-child(3) { width: 11%; }
  th[scope="col"]:nth-child(4) { width: 6.5%; }
  th[scope="col"]:nth-child(5) { width: 6.5%; }
  th[scope="col"]:nth-child(6) { width: 10%; }
  th[scope="col"]:nth-child(7) { width: 8%; }
  {# Les colonnes de remise famille (à partir de la 8ᵉ) se partagent
     le reste de la largeur, quel que soit leur nombre. #}
  {% for _ in remises_famille %}
  th[scope="col"]:nth-child({{ 7 + loop.index }}) { width: {{ (34 / remises_famille | length) | round(2) }}%; }
  {% endfor %}
  caption { font-size: 14px; padding-bottom: 0.5rem; }
  th, td { padding: 0.5rem 0.45rem; }
  td { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .notes { margin-top: 1rem; }
  .notes p, .notes span { font-size: 14px; font-weight: normal; margin: 0.35rem 0; }
}
{% endblock %}
{% block contenu %}
{% if pdf_disponible %}
<p class="telecharger">
  <a href="{{ pdf_tarifs }}" download>Télécharger les tarifs en PDF</a>
</p>
{% endif %}
<div class="defilement">
  <table>
    <caption>Montants en euros. Les remises de {{ remises_famille.values() | join(', ') }} % s'appliquent uniquement sur la part compagnie.</caption>
    <thead>
      <tr>
        <th scope="col" style="text-align:left">Catégorie</th>
        <th scope="col">Licence<br>FFTA</th>
        <th scope="col">Évènement<br>exceptionnel</th>
        <th scope="col">Ligue</th>
        <th scope="col">Dépt.</th>
        <th scope="col">Part<br>compagnie</th>
        <th scope="col">Archer<br>seul</th>
        {% for rang, pct in remises_famille.items() %}
        <th scope="col">{{ rang }}<sup>ème</sup><br>archer<br>famille<br>(−{{ pct }} %)</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for ligne in lignes_tarifs %}
      <tr>
        <th scope="row">{{ ligne.libelle }}{% if ligne.get('naissance') %}<small>{{ ligne['naissance'] }}</small>{% endif %}</th>
        <td>{{ ligne.ffta }}</td>
        <td>{{ ligne.evenement }}</td>
        <td>{{ ligne.ligue }}</td>
        <td>{{ ligne.departement }}</td>
        <td>{{ ligne.part_compagnie }}</td>
        <td class="total">{{ ligne.seul }}</td>
        {% for montant in ligne.rangs %}
        <td class="total">{{ montant }}</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<div class="notes">
  {% for s in supplements %}
  <p>
    {{ s.titre }} :
    <span>{{ s.montant_fmt }} €</span>
    {{ s.libelle }}
  </p>
  {% endfor %}
</div>
{% endblock %}
